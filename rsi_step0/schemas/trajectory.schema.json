{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rsi.step0/schemas/trajectory.schema.json",
  "title": "RSI Step0 TrajectoryRecord",
  "type": "object",
  "required": [
    "schema_version",
    "record_id",
    "run_id",
    "round",
    "step",
    "operator",
    "mode",
    "target",
    "decision",
    "context",
    "action",
    "outcome",
    "reward",
    "label",
    "dedupe_key",
    "provenance",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["rsi_trajectory/v1"]
    },
    "record_id": { "type": "string" },
    "run_id": { "type": "string" },
    "round": { "type": "integer" },
    "step": { "type": "integer" },
    "operator": {
      "type": "string",
      "enum": ["draft", "improve", "crossover", "tune", "evaluate", "question", "implement", "debug", "schedule"]
    },
    "mode": {
      "type": "string",
      "enum": ["thinking", "execution", "scheduling"]
    },
    "target": { "type": "string" },
    "decision": { "type": "object" },
    "context": { "type": "object" },
    "action": { "type": "object" },
    "outcome": { "type": "object" },
    "reward": { "type": "object" },
    "label": {
      "type": "string",
      "enum": ["positive", "negative", "excluded"]
    },
    "dedupe_key": { "type": "string" },
    "provenance": { "type": "object" },
    "created_at": { "type": "string" }
  },
  "additionalProperties": true
}
