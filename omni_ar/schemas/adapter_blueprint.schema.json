{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omni-ar.local/schemas/adapter_blueprint.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "task", "fields", "split", "baseline", "metrics",
    "search", "activation_diagnostics", "resources"
  ],
  "properties": {
    "schema_version": {"const": "omni-ar-adapter-blueprint/v1"},
    "task": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "modality", "description"],
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "modality": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "fields": {
      "type": "object", "additionalProperties": false,
      "required": ["inputs", "label", "sample_id", "groups", "time"],
      "properties": {
        "inputs": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "label": {"type": ["string", "null"]},
        "sample_id": {"type": ["string", "null"]},
        "groups": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "time": {"type": ["string", "null"]}
      }
    },
    "split": {
      "type": "object", "additionalProperties": false,
      "required": ["strategy", "validation_fraction", "seed"],
      "properties": {
        "strategy": {"enum": ["predefined", "stratified", "random", "group", "time", "custom"]},
        "validation_fraction": {"type": "number", "minimum": 0.05, "maximum": 0.5},
        "seed": {"type": "integer"}
      }
    },
    "baseline": {
      "type": "object", "additionalProperties": false,
      "required": ["method", "parameters"],
      "properties": {
        "method": {"type": "string", "minLength": 1},
        "parameters": {"type": "object", "additionalProperties": {"type": ["string", "number", "integer", "boolean", "null"]}}
      }
    },
    "metrics": {
      "type": "object", "additionalProperties": false,
      "required": ["primary", "secondary"],
      "properties": {
        "primary": {"$ref": "#/$defs/metric"},
        "secondary": {"type": "array", "items": {"$ref": "#/$defs/metric"}}
      }
    },
    "search": {
      "type": "object", "additionalProperties": false,
      "required": ["methods", "parameters"],
      "properties": {
        "methods": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"type": "string"}, "uniqueItems": true},
        "parameters": {
          "type": "object",
          "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
          "additionalProperties": {
            "type": "object", "additionalProperties": true,
            "required": ["type"],
            "properties": {"type": {"enum": ["string", "integer", "number", "boolean", "scalar"]}}
          }
        }
      }
    },
    "activation_diagnostics": {
      "type": "array", "minItems": 1,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}, "uniqueItems": true
    },
    "resources": {
      "type": "object", "additionalProperties": false,
      "required": ["gpu_count", "max_runtime_minutes"],
      "properties": {
        "gpu_count": {"type": "integer", "minimum": 0},
        "gpu_type": {"type": "string"},
        "max_runtime_minutes": {"type": "integer", "minimum": 1, "maximum": 1440}
      }
    }
  },
  "$defs": {
    "metric": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "direction", "role"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]*$"},
        "direction": {"enum": ["maximize", "minimize"]},
        "role": {"enum": ["primary", "constraint", "diagnostic"]}
      }
    }
  }
}
