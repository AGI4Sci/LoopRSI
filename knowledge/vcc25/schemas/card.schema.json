{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rsi.local/schemas/vcc25/card.schema.json",
  "title": "VCC25 Knowledge Card",
  "type": "object",
  "required": ["id", "schema_version", "asset_type", "title", "summary_plain", "tags", "layers", "sources", "relations", "review_status", "review_basis"],
  "properties": {
    "id": {"type": "string", "pattern": "^kb:(paper|repo|model):"},
    "schema_version": {"const": "1.0"},
    "asset_type": {"enum": ["paper", "repository", "model"]},
    "title": {"type": "string", "minLength": 1},
    "summary_plain": {"type": "string", "minLength": 1},
    "tags": {"type": "array", "items": {"type": "string"}},
    "layers": {"type": "array", "items": {"enum": ["L1", "L2", "L3", "L4", "L5"]}},
    "sources": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "relations": {"type": "array", "items": {"type": "string"}},
    "review_status": {"enum": ["approved", "draft", "rejected"]},
    "review_basis": {"type": "string"}
  }
}
