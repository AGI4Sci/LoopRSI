# Task-agnostic controller entry point.
#
# Select a concrete case configuration instead of placing dataset, modality,
# model, metric, or directory assumptions in this framework-level file:
#
#   CONTROLLER_CONFIG=/abs/path/to/case/controller.env \
#     bash controller_bash/run_loop.sh 1
#
# The local controller_bash/.env may also set CONTROLLER_CONFIG. A complete
# template is available at configs/task_agnostic.env.example.

echo "ERROR: select a case config with CONTROLLER_CONFIG; see controller_bash/configs/task_agnostic.env.example" >&2
return 2
