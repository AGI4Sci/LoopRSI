# Shared infrastructure defaults for the development machine. Beam is the
# verified GPU path; use execution.deepdivegzy.env for the previous quota.
OMNI_AR_SHARED_ROOT=/mnt/shared-storage-user/huangwenxuan/zhangzhicheng/omni-ar_git
RJOB_NAMESPACE=ailab-beam
RJOB_CHARGED_GROUP=beam_gpu
RJOB_IMAGE=registry.h.pjlab.org.cn/ailab-beam-beam_gpu/slime:v0
RJOB_GPU_LIMIT=1
RJOB_GPU_PER_TRIAL=1
RJOB_CPU=8
RJOB_MEMORY=20000
RJOB_MOUNT=
RJOB_PRIVATE_MACHINE=group
RJOB_HOST_NETWORK=false
RJOB_TAIL_LINES=500
RJOB_LOG_RETRIES=3
RJOB_LOG_RETRY_INTERVAL_SEC=10
RJOB_POLL_INTERVAL_SEC=15
RJOB_TIMEOUT_MIN=60
RJOB_CANCEL_ON_TIMEOUT=1
RJOB_SUBMIT_RETRIES=3
RJOB_SUBMIT_RETRY_INTERVAL_SEC=10
