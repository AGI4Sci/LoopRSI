# Case configuration retained for reproducing the original CV experiment.
# This file may point at a concrete project, but controller logic must remain
# project-agnostic. Keep secrets in HEURESIS_ENV_FILE.

ROOT_DIR=/mnt/shared-storage-gpfs2/beam-gpfs02/huangwenxuan/omni-ar
PROJECT_ROOT=/mnt/shared-storage-gpfs2/beam-gpfs02/huangwenxuan/omni-ar/case01_cv
TASK_SPEC=/mnt/shared-storage-gpfs2/beam-gpfs02/huangwenxuan/omni-ar/case01_cv/task_spec.yaml
HEURESIS_DIR=/mnt/shared-storage-gpfs2/beam-gpfs02/huangwenxuan/omni-ar/Heuresis_PJLAB-boyue
IMPLEMENTATION_DIR=/mnt/shared-storage-gpfs2/beam-gpfs02/huangwenxuan/omni-ar/case01_cv/01implementation
CONTROLLER_DIR=/mnt/shared-storage-gpfs2/beam-gpfs02/huangwenxuan/omni-ar/controller_bash

PYTHON=/mnt/shared-storage-gpfs2/beam-gpfs02/huangwenxuan/omni-ar/Heuresis_PJLAB-boyue/.venv/bin/python
CODEX_BIN=/root/.local/bin/codex
HEURESIS_ENV_FILE=/mnt/shared-storage-gpfs2/beam-gpfs02/huangwenxuan/omni-ar/Heuresis_PJLAB-boyue/.env

# Optional upstream command. Leave empty when upstream idea/code generation has
# already completed.
UPSTREAM_RUN_COMMAND=

# Generic context sources. Use colon-separated path/glob lists.
CONTEXT_TEXT_FILES=/mnt/shared-storage-gpfs2/beam-gpfs02/huangwenxuan/omni-ar/case01_cv/00human-ideas/ambiguous_idea.md:/mnt/shared-storage-gpfs2/beam-gpfs02/huangwenxuan/omni-ar/case01_cv/00machine_ideas/case01_auto.detail.en.md:/mnt/shared-storage-gpfs2/beam-gpfs02/huangwenxuan/omni-ar/case01_cv/01implementation/README.md:/mnt/shared-storage-gpfs2/beam-gpfs02/huangwenxuan/omni-ar/case01_cv/01implementation/IMPLEMENTATION_PLAN.md:/mnt/shared-storage-gpfs2/beam-gpfs02/huangwenxuan/omni-ar/case01_cv/01implementation/ASSUMPTIONS_AND_DEVIATIONS.md:/mnt/shared-storage-gpfs2/beam-gpfs02/huangwenxuan/omni-ar/case01_cv/01implementation/reports/*.md
CONTEXT_JSON_FILES=/mnt/shared-storage-gpfs2/beam-gpfs02/huangwenxuan/omni-ar/case01_cv/00machine_ideas/ideaspark_run_auto/phase4/method_view.json:/mnt/shared-storage-gpfs2/beam-gpfs02/huangwenxuan/omni-ar/case01_cv/00machine_ideas/ideaspark_run_auto/phase4/phase4_implementability.json:/mnt/shared-storage-gpfs2/beam-gpfs02/huangwenxuan/omni-ar/case01_cv/01implementation/artifacts/*.json:/mnt/shared-storage-gpfs2/beam-gpfs02/huangwenxuan/omni-ar/controller_bash/state/evidence_ledger.json:/mnt/shared-storage-gpfs2/beam-gpfs02/huangwenxuan/omni-ar/controller_bash/state/round_*/trial_results.json:/mnt/shared-storage-gpfs2/beam-gpfs02/huangwenxuan/omni-ar/controller_bash/state/round_*/round_summary.json
CONTEXT_CODE_GLOBS=/mnt/shared-storage-gpfs2/beam-gpfs02/huangwenxuan/omni-ar/case01_cv/01implementation/**/*.py
CONTEXT_MAX_CHARS_PER_FILE=30000

# Loop state.
LOOP_START_ROUND=0
LOOP_MAX_ROUNDS=3
CONTINUE_ON_TRIAL_FAILURE=1
MAX_TRIALS_PER_ROUND=12
MAX_CODE_CHANGES_PER_ROUND=8
ROUND_PREFIX=round
STATE_DIR=/mnt/shared-storage-gpfs2/beam-gpfs02/huangwenxuan/omni-ar/controller_bash/state
REPORT_DIR=/mnt/shared-storage-gpfs2/beam-gpfs02/huangwenxuan/omni-ar/case01_cv/01implementation/reports
ARTIFACT_DIR=/mnt/shared-storage-gpfs2/beam-gpfs02/huangwenxuan/omni-ar/case01_cv/01implementation/artifacts
EVIDENCE_LEDGER=/mnt/shared-storage-gpfs2/beam-gpfs02/huangwenxuan/omni-ar/controller_bash/state/evidence_ledger.json

# Heuresis/Boyue suggestion adapter.
HEURESIS_SUGGESTION_MODE=real
HEURESIS_SUGGESTION_TEMPERATURE=0.25
HEURESIS_SUGGESTION_TIMEOUT_SEC=180
HEURESIS_SUGGESTION_MAX_RETRIES=2
HEURESIS_SUGGESTION_JSON_RETRIES=2
SUGGESTION_SCHEMA=/mnt/shared-storage-gpfs2/beam-gpfs02/huangwenxuan/omni-ar/controller_bash/schemas/proposal_v2.schema.json

# Codex execution. Keep code application disabled by default until suggestions are reviewed.
CODEX_MODEL=
CODEX_SANDBOX=workspace-write
CODEX_APPROVAL_POLICY=never
CODEX_ALLOWED_DIR=/mnt/shared-storage-gpfs2/beam-gpfs02/huangwenxuan/omni-ar/case01_cv/01implementation
CODEX_APPLY_MODE=real
RUN_CODEX_APPLY=0
RUN_STATIC_CHECK=1
RUN_GPU_SMOKE=0
STATIC_CHECK_COMMAND=

# Optional upstream and experiment switches.
RUN_UPSTREAM=0
RUN_HEURESIS_SUGGEST=1
RUN_VALIDATE_SUGGESTION=1
RUN_TRIALS=1
RUN_SUMMARIZE_ROUND=1
RUN_UPDATE_LEDGER=1
DRY_RUN=0
RESUME_EXISTING=1

# Generic trial execution. Each suggestion trial may contain either a full
# `command` string or arbitrary fields consumed by TRIAL_COMMAND_TEMPLATE.
TRIAL_EXECUTION_MODE=skip
TRIAL_WORKDIR=/mnt/shared-storage-gpfs2/beam-gpfs02/huangwenxuan/omni-ar/case01_cv/01implementation
TRIAL_COMMAND_TEMPLATE='python3 - <<'"'"'PY'"'"'
import json
from pathlib import Path
Path("{output}").write_text(json.dumps({{"status": "skipped_template", "trial": {trial_json}}}, indent=2))
print("{output}")
PY'
TRIAL_ARTIFACT_SUBDIR=controller_trials

# GPU/rjob resource defaults for future experiment execution scripts.
GPU_GUIDE_DIR=/mnt/shared-storage-gpfs2/beam-gpfs02/huangwenxuan/omni-ar/h集群教程
RJOB_NAMESPACE=ailab-deepdivegzy
RJOB_CHARGED_GROUP=deepdivegzy_gpu_pool
RJOB_IMAGE=registry.h.pjlab.org.cn/ailab-deepdivegzy-deepdivegzy_gpu/slime:v0
RJOB_GPU_LIMIT=2
RJOB_GPU_PER_TRIAL=1
RJOB_CPU=20
RJOB_MEMORY=20000
RJOB_MOUNT=gpfs://gpfs2/beam-gpfs02:/mnt/shared-storage-gpfs2/beam-gpfs02
RJOB_PRIVATE_MACHINE=group
RJOB_HOST_NETWORK=false
RJOB_TAIL_LINES=500
RJOB_LOG_RETRIES=3
RJOB_LOG_RETRY_INTERVAL_SEC=10
RJOB_POLL_INTERVAL_SEC=60
RJOB_TIMEOUT_MIN=180
