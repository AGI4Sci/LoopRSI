ROOT_DIR=/mnt/shared-storage-user/gaozhangyang/RSI
PROJECT_ROOT=/mnt/shared-storage-user/gaozhangyang/RSI/tasks/vcc25
TASK_SPEC=/mnt/shared-storage-user/gaozhangyang/RSI/tasks/vcc25/task_spec.yaml
CONTROLLER_DIR=/mnt/shared-storage-user/gaozhangyang/RSI/controller_bash
HEURESIS_DIR=/mnt/shared-storage-user/gaozhangyang/RSI
IMPLEMENTATION_DIR=/mnt/shared-storage-user/gaozhangyang/RSI/tasks/vcc25/implementation
PYTHON=/bin/python3
PYTHONPATH=/mnt/shared-storage-user/gaozhangyang/RSI
CODEX_BIN=codex

# Multi-round genuine RSI loop
LOOP_START_ROUND=0
LOOP_MAX_ROUNDS=3
MAX_TRIALS_PER_ROUND=1
CONTINUE_ON_TRIAL_FAILURE=1
ROUND_PREFIX=round
STATE_DIR=/mnt/shared-storage-user/gaozhangyang/RSI/output/vcc25/state
REPORT_DIR=/mnt/shared-storage-user/gaozhangyang/RSI/output/vcc25/reports
ARTIFACT_DIR=/mnt/shared-storage-user/gaozhangyang/RSI/output/vcc25/artifacts
EVIDENCE_LEDGER=/mnt/shared-storage-user/gaozhangyang/RSI/output/vcc25/state/evidence_ledger.json

# Suggest + apply: use heuristic suggestion (no external LLM keys on this user), no codex apply
HEURESIS_SUGGESTION_MODE=heuristic
RUN_HEURESIS_SUGGEST=0
RUN_VALIDATE_SUGGESTION=1
RUN_CODEX_APPLY=0
RUN_STATIC_CHECK=0
RUN_TRIALS=1
RUN_SUMMARIZE_ROUND=1
RUN_UPDATE_LEDGER=1
DRY_RUN=0
RESUME_EXISTING=0

# Real GPU execution via rjob
TRIAL_EXECUTION_MODE=rjob
TRIAL_WORKDIR_IN_PACKAGE=.
TRIAL_PYTHONPATH_IN_PACKAGE=.
RJOB_NAMESPACE=ailab-beam
RJOB_CHARGED_GROUP=beam_gpu
RJOB_IMAGE=registry.h.pjlab.org.cn/ailab-beam-beam_gpu/slime:v0
RJOB_GPU_LIMIT=1
RJOB_GPU_PER_TRIAL=1
RJOB_CPU=8
RJOB_MEMORY=64000
RJOB_TIMEOUT_MIN=180
RJOB_POLL_INTERVAL_SEC=15
RJOB_SYNC_SOURCE=/mnt/shared-storage-user/gaozhangyang/RSI
RJOB_SHARED_FOLDER=/mnt/shared-storage-user/gaozhangyang/rjob_packages/rsi_vcc25_multi
RJOB_SYNC_PATHS=tasks:controller_bash:ai4ai:omni_ar:datasets
RJOB_SUBMIT_RETRIES=2
RJOB_CANCEL_ON_TIMEOUT=1
