PYTHON=/data/zhangzhicheng/omni-ar/Heuresis_PJLAB-boyue/.venv/bin/python
PYTHONPATH=/data/zhangzhicheng/omni-ar_heuresis-skill

CONTEXT_TEXT_FILES=/data/zhangzhicheng/omni-ar_heuresis-skill/tasks/vcc25/task_context.md
CONTEXT_JSON_FILES=/data/zhangzhicheng/omni-ar_heuresis-skill/regression_anchors/vcc25/optimization_summary.json
