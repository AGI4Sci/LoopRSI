EVIDENCE_LEDGER=/data/zhangzhicheng/omni-ar_heuresis-skill/runs/vcc25_skill_round_20260912/state/evidence_ledger.json

RUN_SKILL_INJECTION=1
HEURESIS_SUGGESTION_MODE=real
HEURESIS_SUGGESTION_TEMPERATURE=0.1
HEURESIS_SUGGESTION_TIMEOUT_SEC=300
HEURESIS_SUGGESTION_MAX_RETRIES=1
HEURESIS_SUGGESTION_JSON_RETRIES=3
SUGGESTION_SCHEMA=/data/zhangzhicheng/omni-ar_heuresis-skill/controller_bash/schemas/proposal_v2.schema.json

RUN_UPSTREAM=0
RUN_HEURESIS_SUGGEST=1
RUN_VALIDATE_SUGGESTION=1
RUN_CODEX_APPLY=0
RUN_STATIC_CHECK=1
RUN_TRIALS=1
RUN_SUMMARIZE_ROUND=1
RUN_UPDATE_LEDGER=1
DRY_RUN=0
CONTINUE_ON_TRIAL_FAILURE=1

TRIAL_EXECUTION_MODE=rjob
TRIAL_WORKDIR=/data/zhangzhicheng/omni-ar_heuresis-skill/tasks/vcc25/implementation
TRIAL_PYTHONPATH=/data/zhangzhicheng/omni-ar_heuresis-skill
TRIAL_WORKDIR_IN_PACKAGE=tasks/vcc25/implementation
TRIAL_PYTHONPATH_IN_PACKAGE=../..
COMMAND_IMPLEMENTATION_DIR_IN_PACKAGE=.
DATASET_DIR_IN_PACKAGE=../../../datasets/vcc25
PROJECT_ROOT_IN_PACKAGE=../../..
TRIAL_ARTIFACT_SUBDIR=controller_trials

OMNI_AR_SHARED_ROOT=/mnt/shared-storage-user/huangwenxuan/zhangzhicheng/omni-ar-heuresis-skill
RJOB_NAMESPACE=ailab-deepdivegzy
RJOB_CHARGED_GROUP=deepdivegzy_gpu_pool
RJOB_IMAGE=registry.h.pjlab.org.cn/ailab-deepdivegzy-deepdivegzy_gpu/slime:v0
RJOB_GPU_LIMIT=1
RJOB_GPU_PER_TRIAL=1
RJOB_CPU=8
RJOB_MEMORY=20000
RJOB_PRIVATE_MACHINE=group
RJOB_HOST_NETWORK=false
RJOB_TAIL_LINES=500
RJOB_LOG_RETRIES=3
RJOB_LOG_RETRY_INTERVAL_SEC=10
RJOB_POLL_INTERVAL_SEC=15
RJOB_TIMEOUT_MIN=180
RJOB_SYNC_SOURCE=/data/zhangzhicheng/omni-ar_heuresis-skill
RJOB_SHARED_FOLDER=/mnt/shared-storage-user/huangwenxuan/zhangzhicheng/omni-ar-heuresis-skill/rjob_packages/vcc25_skill_round_20260912
RJOB_SYNC_EXCLUDES=.git/:.venv/:__pycache__/:*.pyc:runs/*/artifacts/controller_trials/*.rjob.log
RJOB_SYNC_PATHS=tasks:controller_bash:datasets/vcc25:ai4ai:skills:runs/vcc25_skill_round_20260912
RJOB_CANCEL_ON_TIMEOUT=1
RJOB_SUBMIT_RETRIES=1
RJOB_SUBMIT_TIMEOUT_SECONDS=600
