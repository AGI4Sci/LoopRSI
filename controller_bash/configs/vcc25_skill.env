CONTEXT_MAX_CHARS_PER_FILE=30000

LOOP_START_ROUND=0
LOOP_MAX_ROUNDS=1
MAX_TRIALS_PER_ROUND=3
MAX_CODE_CHANGES_PER_ROUND=0
REQUIRE_ADAPTER_TRIAL_ENTRYPOINT=1
ROUND_PREFIX=round
STATE_DIR=/data/zhangzhicheng/omni-ar_heuresis-skill/runs/vcc25_skill_round_20260912/state
REPORT_DIR=/data/zhangzhicheng/omni-ar_heuresis-skill/runs/vcc25_skill_round_20260912/reports
