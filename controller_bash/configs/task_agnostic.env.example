# Copy this file into a case directory, then replace every /abs/path placeholder.
# Task semantics belong in context files and the case implementation, not in
# controller scripts or framework prompts.

ROOT_DIR=/abs/path/to/workspace
PROJECT_ROOT=/abs/path/to/case
TASK_SPEC=/abs/path/to/case/task_spec.yaml
HEURESIS_DIR=/abs/path/to/heuresis
IMPLEMENTATION_DIR=/abs/path/to/case/implementation
CONTROLLER_DIR=/abs/path/to/workspace/controller_bash
PYTHON=/abs/path/to/heuresis/.venv/bin/python
CODEX_BIN=/abs/path/to/codex
HEURESIS_ENV_FILE=/abs/path/to/heuresis/.env

UPSTREAM_RUN_COMMAND=
CONTEXT_TEXT_FILES=/abs/path/to/case/idea.md:/abs/path/to/case/implementation/README.md:/abs/path/to/case/reports/*.md
CONTEXT_JSON_FILES=/abs/path/to/case/artifacts/*.json:/abs/path/to/case/state/round_*/trial_results.json
CONTEXT_CODE_GLOBS=/abs/path/to/case/implementation/**/*.py
CONTEXT_MAX_CHARS_PER_FILE=30000

LOOP_START_ROUND=0
LOOP_MAX_ROUNDS=3
CONTINUE_ON_TRIAL_FAILURE=1
MAX_TRIALS_PER_ROUND=1
MAX_CODE_CHANGES_PER_ROUND=8
ROUND_PREFIX=round
STATE_DIR=/abs/path/to/case/state
REPORT_DIR=/abs/path/to/case/reports
ARTIFACT_DIR=/abs/path/to/case/artifacts
EVIDENCE_LEDGER=/abs/path/to/case/state/evidence_ledger.json

HEURESIS_SUGGESTION_MODE=real
HEURESIS_SUGGESTION_TEMPERATURE=0.25
HEURESIS_SUGGESTION_TIMEOUT_SEC=180
HEURESIS_SUGGESTION_MAX_RETRIES=2
HEURESIS_SUGGESTION_JSON_RETRIES=2
SUGGESTION_SCHEMA=/abs/path/to/workspace/controller_bash/schemas/proposal_v2.schema.json

CODEX_MODEL=
CODEX_SANDBOX=workspace-write
CODEX_APPROVAL_POLICY=never
CODEX_ALLOWED_DIR=/abs/path/to/case/implementation
CODEX_APPLY_MODE=real
RUN_CODEX_APPLY=0
RUN_STATIC_CHECK=1
RUN_GPU_SMOKE=0
STATIC_CHECK_COMMAND=

RUN_UPSTREAM=0
RUN_HEURESIS_SUGGEST=1
RUN_VALIDATE_SUGGESTION=1
RUN_TRIALS=1
RUN_SUMMARIZE_ROUND=1
RUN_UPDATE_LEDGER=1
DRY_RUN=0
RESUME_EXISTING=1

TRIAL_EXECUTION_MODE=skip
TRIAL_WORKDIR=/abs/path/to/case/implementation
TRIAL_COMMAND_TEMPLATE=
TRIAL_ARTIFACT_SUBDIR=controller_trials
TRIAL_WORKDIR_IN_PACKAGE=path/to/case/implementation
TRIAL_PYTHONPATH_IN_PACKAGE=relative/path/from/implementation/to/package/root
COMMAND_IMPLEMENTATION_DIR_IN_PACKAGE=.
DATASET_DIR_IN_PACKAGE=data
PROJECT_ROOT_IN_PACKAGE=..

# Cluster values are infrastructure-specific configuration, not task semantics.
RJOB_NAMESPACE=replace_me
RJOB_CHARGED_GROUP=replace_me
RJOB_IMAGE=replace_me
RJOB_GPU_LIMIT=1
RJOB_GPU_PER_TRIAL=1
RJOB_CPU=8
RJOB_MEMORY=16000
RJOB_MOUNT=replace_me
RJOB_PRIVATE_MACHINE=group
RJOB_HOST_NETWORK=false
RJOB_TAIL_LINES=500
RJOB_LOG_RETRIES=3
RJOB_LOG_RETRY_INTERVAL_SEC=10
RJOB_POLL_INTERVAL_SEC=60
RJOB_TIMEOUT_MIN=60
# Controller-owned packaging. The source must contain generated trial workers;
# the destination must be on the user shared filesystem visible to rjob.
RJOB_SYNC_SOURCE=/abs/path/to/local/case
RJOB_SHARED_FOLDER=/mnt/shared-storage-user/replace_me/omni-ar/rjob_packages/case
RJOB_SYNC_EXCLUDES=.git/:.venv/:__pycache__/:*.pyc
# Colon-separated paths relative to RJOB_SYNC_SOURCE. Use only the task package
# and generic runtime needed by the worker; do not upload unrelated datasets.
RJOB_SYNC_PATHS=tasks:controller_bash:path/to/case
RJOB_CANCEL_ON_TIMEOUT=1
# Deprecated compatibility alias. New configurations should use the two fields above.
RJOB_FOLDER=
