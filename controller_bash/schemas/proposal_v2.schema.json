{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omni-ar.local/schemas/proposal_v2.schema.json",
  "title": "OMNI-AR Structured Auto-Research Proposal v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "proposal_id",
    "task_name",
    "round",
    "verdict",
    "evidence_gaps",
    "experiment_proposals",
    "risks"
  ],
  "properties": {
    "schema_version": {"const": "omni-ar-proposal/v2"},
    "proposal_id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"},
    "task_name": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
    "round": {"type": "integer", "minimum": 0},
    "verdict": {"type": "string", "minLength": 1},
    "evidence_gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim", "gap", "why_it_matters"],
        "properties": {
          "claim": {"type": "string"},
          "gap": {"type": "string"},
          "why_it_matters": {"type": "string"}
        }
      }
    },
    "experiment_proposals": {
      "type": "array",
      "items": {"$ref": "#/$defs/experimentProposal"}
    },
    "implementation_requests": {
      "type": "array",
      "items": {"$ref": "#/$defs/implementationRequest"}
    },
    "risks": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "implementationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "hypothesis", "change_scope", "allowed_paths", "required_capabilities", "activation_diagnostics", "trial_proposal"],
      "properties": {
        "request_id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"},
        "hypothesis": {"type": "string", "minLength": 1},
        "change_scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}},
        "allowed_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "required_capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}},
        "activation_diagnostics": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}},
        "trial_proposal": {"$ref": "#/$defs/experimentProposal"}
      }
    },
    "experimentProposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hypothesis", "change_scope", "parameters", "expected_effect", "acceptance_criteria", "resource_request"],
      "properties": {
        "hypothesis": {"type": "string", "minLength": 1},
        "change_scope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
        },
        "parameters": {
          "type": "object",
          "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
          "additionalProperties": {
            "oneOf": [
              {"type": ["string", "number", "integer", "boolean", "null"]},
              {
                "type": "array",
                "items": {"type": ["string", "number", "integer", "boolean", "null"]}
              }
            ]
          }
        },
        "expected_effect": {"type": "object"},
        "mechanism_alignment": {
          "type": "object",
          "additionalProperties": true
        },
        "acceptance_criteria": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["operator", "value"],
            "properties": {
              "operator": {"enum": [">", ">=", "<", "<=", "=="]},
              "value": {"type": "number"}
            }
          }
        },
        "resource_request": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "gpu_count": {"type": "integer", "minimum": 0},
            "cpu": {"type": "integer", "minimum": 1},
            "memory_mb": {"type": "integer", "minimum": 1},
            "max_runtime_minutes": {"type": "integer", "minimum": 1}
          }
        }
      }
    }
  }
}
