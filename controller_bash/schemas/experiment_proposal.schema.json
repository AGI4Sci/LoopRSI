{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omni-ar.local/schemas/experiment_proposal.schema.json",
  "title": "OMNI-AR Structured Experiment Proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "hypothesis",
    "change_scope",
    "parameters",
    "expected_effect",
    "acceptance_criteria",
    "resource_request"
  ],
  "properties": {
    "hypothesis": {"type": "string", "minLength": 1},
    "change_scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
    },
    "parameters": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
      "additionalProperties": {
        "oneOf": [
          {"type": ["string", "number", "integer", "boolean", "null"]},
          {
            "type": "array",
            "items": {"type": ["string", "number", "integer", "boolean", "null"]}
          }
        ]
      }
    },
    "expected_effect": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {"type": "string"},
          {"type": "number"},
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["direction"],
            "properties": {
              "direction": {"enum": ["increase", "decrease", "unchanged"]},
              "minimum_change": {"type": "number"}
            }
          }
        ]
      }
    },
    "acceptance_criteria": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operator", "value"],
        "properties": {
          "operator": {"enum": [">", ">=", "<", "<=", "=="]},
          "value": {"type": "number"}
        }
      }
    },
    "resource_request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gpu_count": {"type": "integer", "minimum": 0},
        "cpu": {"type": "integer", "minimum": 1},
        "memory_mb": {"type": "integer", "minimum": 1},
        "max_runtime_minutes": {"type": "integer", "minimum": 1}
      }
    }
  }
}
