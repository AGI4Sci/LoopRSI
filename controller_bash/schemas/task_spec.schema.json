{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omni-ar.local/schemas/task_spec.schema.json",
  "title": "OMNI-AR Task Specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task", "workspace", "adapter", "entrypoints", "data", "metrics", "search"],
  "properties": {
    "schema_version": {"enum": ["omni-ar-task/v1", "omni-ar-task/v2"]},
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "modality", "description"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
        "type": {"type": "string", "minLength": 1},
        "modality": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base", "project_root", "implementation_dir"],
      "properties": {
        "base": {"enum": ["spec", "repository"]},
        "project_root": {"$ref": "#/$defs/relativePath"},
        "implementation_dir": {"$ref": "#/$defs/relativePath"}
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module", "class_name", "actions", "trial_defaults"],
      "properties": {
        "module": {"$ref": "#/$defs/relativePath"},
        "class_name": {"type": "string", "pattern": "^[A-Z][a-zA-Z0-9]*$"},
        "trial_defaults": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
          "additionalProperties": {"type": ["string", "number", "integer", "boolean", "null"]}
        },
        "actions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["prepare_data", "validate_data", "run_baseline", "run_trial", "evaluate", "summarize_results"],
          "properties": {
            "prepare_data": {"$ref": "#/$defs/command"},
            "validate_data": {"$ref": "#/$defs/command"},
            "run_baseline": {"$ref": "#/$defs/command"},
            "run_trial": {"$ref": "#/$defs/command"},
            "evaluate": {"$ref": "#/$defs/command"},
            "summarize_results": {"$ref": "#/$defs/command"}
          }
        }
      }
    },
    "entrypoints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["train", "evaluate"],
      "properties": {
        "train": {"$ref": "#/$defs/command"},
        "evaluate": {"$ref": "#/$defs/command"}
      }
    },
    "data": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["train", "validation"],
          "properties": {
            "train": {"$ref": "#/$defs/dataSplit"},
            "validation": {"$ref": "#/$defs/dataSplit"},
            "test": {"$ref": "#/$defs/dataSplit"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["dataset_ref", "bindings"],
          "properties": {
            "dataset_ref": {"type": "string", "pattern": "^[a-z0-9-]+@[^@]+$"},
            "default_artifact": {"type": "string"},
            "runtime_artifacts": {
              "type": "array",
              "items": {"type": "string"},
              "uniqueItems": true
            },
            "bindings": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "properties": {"artifact": {"type": "string"}, "split": {"type": "string"}},
                "oneOf": [{"required": ["artifact"]}, {"required": ["split"]}]
              }
            }
          }
        }
      ]
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "secondary"],
      "properties": {
        "primary": {"$ref": "#/$defs/metricDefinition"},
        "secondary": {
          "type": "array",
          "items": {"$ref": "#/$defs/metricDefinition"},
          "uniqueItems": true
        }
      }
    },
    "search": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path_scope", "editable_paths", "protected_paths"],
      "properties": {
        "path_scope": {"const": "implementation"},
        "editable_paths": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/relativePath"},
          "uniqueItems": true
        },
        "protected_paths": {
          "type": "array",
          "items": {"$ref": "#/$defs/relativePath"},
          "uniqueItems": true
        },
        "interface_editable_paths": {
          "description": "Explicit task-local interface files, relative to repository root.",
          "type": "array",
          "items": {"$ref": "#/$defs/relativePath"},
          "uniqueItems": true
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gpu_count": {"type": "integer", "minimum": 0},
        "gpu_type": {"type": "string"},
        "max_runtime_minutes": {"type": "integer", "minimum": 1},
        "max_trials_per_round": {"type": "integer", "minimum": 1}
      }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "not": {"pattern": "(^/|(^|/)\\.\\.(/|$))"}
    },
    "command": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\{result_path\\}"
    },
    "dataSplit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "format": {"type": "string"},
        "split": {"type": "string"},
        "description": {"type": "string"}
      }
    },
    "metricDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "direction", "source"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]*$"},
        "direction": {"enum": ["maximize", "minimize"]},
        "source": {"type": "string", "pattern": "^[a-zA-Z0-9_][a-zA-Z0-9_.]*$"},
        "description": {"type": "string"},
        "role": {"enum": ["primary", "constraint", "diagnostic"]},
        "constraint": {
          "type": "object",
          "additionalProperties": false,
          "required": ["operator", "value"],
          "properties": {
            "operator": {"enum": [">", ">=", "<", "<=", "=="]},
            "value": {"type": "number"}
          }
        }
      }
    }
  }
}
