{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VCC25 L3 hypothesis decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["layer", "decision_type", "hypothesis", "falsification_criterion"],
  "properties": {
    "layer": {"type": "string", "const": "L3"},
    "decision_type": {"type": "string", "const": "hypothesis"},
    "hypothesis": {"type": "string", "minLength": 1},
    "falsification_criterion": {"type": "string", "minLength": 1}
  }
}
