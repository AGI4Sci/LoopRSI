{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VCC25 L2 problem decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["layer", "decision_type", "problem", "comparison_target"],
  "properties": {
    "layer": {"type": "string", "const": "L2"},
    "decision_type": {"type": "string", "const": "problem"},
    "problem": {"type": "string", "minLength": 1},
    "comparison_target": {"type": "string", "minLength": 1}
  }
}
